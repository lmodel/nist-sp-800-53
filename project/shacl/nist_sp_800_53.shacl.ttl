nist_sp_800_53:AssessmentMethod a sh:NodeShape ;
	rdfs:comment "One assessment method SP 800-53A gives a control or enhancement, with the objects an assessor selects from: documents and records to examine, people to interview, or mechanisms and activities to test." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n37 ;
	sh:property _:c14n6 , _:c14n65 ;
	sh:targetClass nist_sp_800_53:AssessmentMethod .
nist_sp_800_53:AssessmentObjective a sh:NodeShape ;
	rdfs:comment "An assessment objective of SP 800-53A: a determination statement an assessor checks, or a heading that groups the determination statements of one item of the control statement." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n35 ;
	sh:property _:c14n20 , _:c14n3 , _:c14n33 ;
	sh:targetClass nist_sp_800_53:AssessmentObjective .
nist_sp_800_53:Baseline a sh:NodeShape ;
	rdfs:comment "One of the four control baselines SP 800-53B defines: the controls and enhancements selected for systems at the low, moderate or high impact level, or for privacy." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n17 ;
	sh:property _:c14n29 , _:c14n67 , _:c14n79 ;
	sh:targetClass nist_sp_800_53:Baseline .
nist_sp_800_53:Catalog a sh:NodeShape ;
	rdfs:comment "One release of the control catalog as a whole: its families, each holding its controls and their enhancements, the baselines that select from them, and the publications the catalog lists." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n40 ;
	sh:property _:c14n15 , _:c14n42 , _:c14n50 , _:c14n61 ;
	sh:targetClass nist_sp_800_53:Catalog .
nist_sp_800_53:Control a sh:NodeShape ;
	rdfs:comment "A security or privacy control: a safeguard with an identifier, a statement of what it requires, a discussion, parameters the organization defines, related controls, references, the assessment objective and methods SP 800-53A gives it, and its enhancements. A control Revision 5 withdrew keeps its identifier and says where it went." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n24 ;
	sh:property _:c14n1 , _:c14n18 , _:c14n2 , _:c14n31 , _:c14n44 , _:c14n51 , _:c14n56 , _:c14n58 , _:c14n59 , _:c14n66 , _:c14n7 , _:c14n71 , _:c14n74 , _:c14n75 , _:c14n80 , _:c14n84 ;
	sh:targetClass nist_sp_800_53:Control .
nist_sp_800_53:ControlEnhancement a sh:NodeShape ;
	rdfs:comment "A control enhancement: added functionality or strength for a control, with an identifier of its own, which the publication and other documents cite apart from the control. It carries what a control carries, and names the control or enhancement it requires." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n12 ;
	sh:property _:c14n0 , _:c14n10 , _:c14n11 , _:c14n13 , _:c14n16 , _:c14n19 , _:c14n25 , _:c14n39 , _:c14n41 , _:c14n45 , _:c14n46 , _:c14n47 , _:c14n62 , _:c14n69 , _:c14n73 , _:c14n82 ;
	sh:targetClass nist_sp_800_53:ControlEnhancement .
nist_sp_800_53:Family a sh:NodeShape ;
	rdfs:comment "One of the twenty families SP 800-53 sorts its controls into, such as Access Control or Supply Chain Risk Management." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n68 ;
	sh:property _:c14n48 , _:c14n60 , _:c14n8 , _:c14n9 ;
	sh:targetClass nist_sp_800_53:Family .
nist_sp_800_53:Parameter a sh:NodeShape ;
	rdfs:comment "An organization-defined parameter: a value the control statement leaves to the organization, either an assignment the organization fills in or a selection from the choices the publication lists. SP 800-53A labels each parameter but the ones that aggregate others, and gives most a guideline." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n72 ;
	sh:property _:c14n21 , _:c14n22 , _:c14n27 , _:c14n30 , _:c14n38 , _:c14n49 , _:c14n52 , _:c14n57 , _:c14n78 ;
	sh:targetClass nist_sp_800_53:Parameter .
nist_sp_800_53:Reference a sh:NodeShape ;
	rdfs:comment "A publication the catalog's references list, as they list it: its label, its citation and its address." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n63 ;
	sh:property _:c14n34 , _:c14n54 , _:c14n83 ;
	sh:targetClass nist_sp_800_53:Reference .
nist_sp_800_53:Statement a sh:NodeShape ;
	rdfs:comment "A control statement: the text of what a control or enhancement requires, and the items it is divided into." ;
	sh:closed true ;
	sh:ignoredProperties _:c14n43 ;
	sh:property _:c14n26 , _:c14n81 ;
	sh:targetClass nist_sp_800_53:Statement .

_:c14n7 sh:datatype xsd:string ;
	sh:description "For a withdrawn control or enhancement, what it was incorporated into, as the publication states it." ;
	sh:nodeKind sh:Literal ;
	sh:order 9 ;
	sh:path nist_sp_800_53:incorporated_into ;
	sh:pattern "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)(-[1-9][0-9]*(\\([1-9][0-9]*\\))?([a-z](\\.[1-9][0-9]*)*|\\([a-z]\\)(\\([1-9][0-9]*\\))*)?)?$" .
_:c14n70 rdf:first rdf:type ;
	rdf:rest rdf:nil .
_:c14n71 sh:class nist_sp_800_53:ControlEnhancement ;
	sh:description "The control's enhancements. A knowledge bundle relates an enhancement to its control with isPartOf instead." ;
	sh:nodeKind sh:BlankNodeOrIRI ;
	sh:order 15 ;
	sh:path nist_sp_800_53:control_enhancements .
_:c14n72 rdf:first rdf:type ;
	rdf:rest rdf:nil .
_:c14n73 sh:datatype xsd:string ;
	sh:description "The publications the control or enhancement cites, by the labels the catalog's references carry, such as SP 800-12 or OMB A-130." ;
	sh:nodeKind sh:Literal ;
	sh:order 5 ;
	sh:path nist_sp_800_53:control_references ;
	sh:pattern "^\\s*\\S" .
_:c14n74 sh:class nist_sp_800_53:Parameter ;
	sh:description "The organization-defined parameters the statement leaves to the organization, in the order the catalog gives them." ;
	sh:nodeKind sh:BlankNodeOrIRI ;
	sh:order 3 ;
	sh:path nist_sp_800_53:control_parameters .
_:c14n75 sh:datatype xsd:boolean ;
	sh:description "True where NIST's reference data marks the control or enhancement as one that contributes to assurance; absent otherwise." ;
	sh:maxCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 13 ;
	sh:path nist_sp_800_53:contributes_to_assurance .
_:c14n76 rdf:first "INTERVIEW" ;
	rdf:rest _:c14n14 .
_:c14n77 rdf:first "LOW" ;
	rdf:rest _:c14n32 .
_:c14n78 sh:datatype xsd:string ;
	sh:description "The parameter's identifier in NIST's catalog, such as ac-02_odp.01." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 0 ;
	sh:path nist_sp_800_53:parameter_id ;
	sh:pattern "^[a-z]{2}-[0-9]{2}(\\.[0-9]{2})?_odp(\\.[0-9]{2})?$|^[a-z]{2}-[1-9][0-9]*(\\.[1-9][0-9]*)?_prm_[1-9][0-9]*$" .
_:c14n79 sh:description "Which of the four baselines this is." ;
	sh:in _:c14n77 ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:order 1 ;
	sh:path nist_sp_800_53:baseline_level .
_:c14n8 sh:class nist_sp_800_53:Control ;
	sh:description "The controls of the family. A knowledge bundle relates a control to its family with isPartOf instead." ;
	sh:nodeKind sh:BlankNodeOrIRI ;
	sh:order 3 ;
	sh:path nist_sp_800_53:family_controls .
_:c14n80 sh:datatype xsd:string ;
	sh:description "For a withdrawn control or enhancement that the publication neither moved nor incorporated, what it says instead, such as that the enhancement is addressed through tailoring." ;
	sh:maxCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 11 ;
	sh:path nist_sp_800_53:withdrawal_reason .
_:c14n81 sh:datatype xsd:string ;
	sh:description "The statement's own text, before any items. A placeholder of the form {{ insert: param, <identifier> }} marks where an organization-defined parameter is inserted." ;
	sh:maxCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 1 ;
	sh:path nist_sp_800_53:statement_text .
_:c14n82 sh:datatype xsd:string ;
	sh:description "For a withdrawn control or enhancement that the publication neither moved nor incorporated, what it says instead, such as that the enhancement is addressed through tailoring." ;
	sh:maxCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 11 ;
	sh:path nist_sp_800_53:withdrawal_reason .
_:c14n83 sh:description "The address the catalog gives for the publication." ;
	sh:maxCount 1 ;
	sh:nodeKind sh:IRI ;
	sh:order 2 ;
	sh:path nist_sp_800_53:reference_url .
_:c14n84 sh:class nist_sp_800_53:Statement ;
	sh:description "The control statement: what the control or enhancement requires, as one text, a lettered or numbered list of items, or both." ;
	sh:maxCount 1 ;
	sh:nodeKind sh:BlankNodeOrIRI ;
	sh:order 1 ;
	sh:path nist_sp_800_53:control_statement .
_:c14n85 rdf:first "SYSTEM" ;
	rdf:rest rdf:nil .
_:c14n86 rdf:first "ORGANIZATION" ;
	rdf:rest _:c14n85 .
_:c14n87 rdf:first "SYSTEM" ;
	rdf:rest rdf:nil .
_:c14n88 rdf:first "ORGANIZATION" ;
	rdf:rest _:c14n87 .
_:c14n89 rdf:first "WITHDRAWN" ;
	rdf:rest rdf:nil .
_:c14n9 sh:datatype xsd:string ;
	sh:description "The family's two letters, such as AC for Access Control." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:nodeKind sh:Literal ;
	sh:order 2 ;
	sh:path nist_sp_800_53:family_id ;
	sh:pattern "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)$" .
_:c14n90 rdf:first "WITHDRAWN" ;
	rdf:rest rdf:nil .

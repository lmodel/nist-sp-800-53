@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nist_sp_800_53: <https://w3id.org/lmodel/nist-sp-800-53/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix oscal: <https://w3id.org/lmodel/oscal/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
xsd:string a rdfs:Datatype ;
	owl:equivalentClass _:c14n208 , _:c14n210 , _:c14n212 , _:c14n214 , _:c14n216 , _:c14n218 .
<https://w3id.org/lmodel/nist-sp-800-53.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://doi.org/10.6028/NIST.SP.800-53r5> ;
	dcterms:title "NIST SP 800-53 Security and Privacy Controls, Release 5.2.0" ;
	pav:version "5.2.0" ;
	a owl:Ontology ;
	rdfs:comment "A LinkML model of the security and privacy controls that NIST Special Publication 800-53, Revision 5, defines at Release 5.2.0: its twenty control families, their controls and control enhancements, each with its statement, discussion, organization-defined parameters, related controls and references; the assessment objectives and methods that SP 800-53A gives each control; and the four control baselines of SP 800-53B." ;
	rdfs:label "nist_sp_800_53" ;
	rdfs:seeAlso <https://csrc.nist.gov/News/2025/nist-releases-revision-to-sp-800-53-controls> , <https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final> , <https://doi.org/10.6028/NIST.SP.800-53Ar5> , <https://doi.org/10.6028/NIST.SP.800-53B> , <https://github.com/usnistgov/oscal-content/tree/v1.6.0/nist.gov/SP800-53/rev5> , <https://lmodel.github.io/nist-sp-800-53> ;
	skos:note "NIST's catalog renders each family as an OSCAL group, each control and control enhancement as an OSCAL control, each statement, discussion, assessment objective and assessment method as a part, each organization-defined parameter as a parameter, each reference as a back-matter resource, and each baseline as a profile. The broad_mappings name those lmodel/oscal classes." , "SP 800-53, SP 800-53A and SP 800-53B are works of the United States Government and are not subject to copyright in the United States. The descriptions here are this project's own words; NIST's text of each control, parameter, objective and method stays in the catalog copy." , "The version is the release of Revision 5 that the catalog carries, 5.2.0 of August 2025, and publication_date is that release's date; Revision 5 itself was published in September 2020 and updated in December 2020. source is the publication's digital object identifier. NIST's Cybersecurity and Privacy Reference Tool names the same release SP_800_53_5_2_0, and the catalog and the four baseline profiles NIST publishes for it in usnistgov/oscal-content are copied to src/nist_sp_800_53/schema/oscal-content/ at the tag and commit in the annotations. scripts/check_upstream_release.py reads the same pins and reports when NIST publishes a newer edition or changes a copied file. The release tags are the schema's own versions." ;
	nist_sp_800_53:cprt_framework_version "SP_800_53_5_2_0" ;
	nist_sp_800_53:oscal_content_commit "f0de6d8d8c059d374f15e0ae07508d82e370fc1d" ;
	nist_sp_800_53:oscal_content_tag "v1.6.0" ;
	nist_sp_800_53:publication_date "2025-08" .
nist_sp_800_53:Sp80053AssessmentMethod a owl:Class ;
	rdfs:comment "One assessment method SP 800-53A gives a control or enhancement, with the objects an assessor selects from: documents and records to examine, people to interview, or mechanisms and activities to test." ;
	rdfs:label "Sp80053AssessmentMethod" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-53Ar5> ;
	rdfs:subClassOf _:c14n1 , _:c14n108 , _:c14n140 , _:c14n74 , _:c14n79 ;
	skos:broadMatch oscal:Part ;
	skos:exactMatch nist_sp_800_53:AssessmentMethod ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:Sp80053AssessmentMethodKind\#EXAMINE a owl:Class ;
	rdfs:comment "Review, inspect, observe, study or analyze specifications, mechanisms or activities." ;
	rdfs:label "EXAMINE" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053AssessmentMethodKind .
nist_sp_800_53:Sp80053AssessmentMethodKind\#INTERVIEW a owl:Class ;
	rdfs:comment "Hold discussions with individuals or groups." ;
	rdfs:label "INTERVIEW" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053AssessmentMethodKind .
nist_sp_800_53:Sp80053AssessmentMethodKind\#TEST a owl:Class ;
	rdfs:comment "Exercise mechanisms or activities under specified conditions." ;
	rdfs:label "TEST" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053AssessmentMethodKind .
nist_sp_800_53:Sp80053AssessmentMethodKind a owl:Class ;
	rdfs:comment "The three assessment methods of SP 800-53A, as its catalog writes them." ;
	rdfs:label "Sp80053AssessmentMethodKind" ;
	owl:unionOf _:c14n112 ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> ;
	linkml:permissible_values nist_sp_800_53:Sp80053AssessmentMethodKind\#EXAMINE , nist_sp_800_53:Sp80053AssessmentMethodKind\#INTERVIEW , nist_sp_800_53:Sp80053AssessmentMethodKind\#TEST .
nist_sp_800_53:Sp80053AssessmentObjective a owl:Class ;
	rdfs:comment "An assessment objective of SP 800-53A: a determination statement an assessor checks, or a heading that groups the determination statements of one item of the control statement." ;
	rdfs:label "Sp80053AssessmentObjective" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-53Ar5> ;
	rdfs:subClassOf _:c14n135 , _:c14n151 , _:c14n153 , _:c14n176 , _:c14n34 , _:c14n65 , _:c14n75 , _:c14n93 ;
	skos:broadMatch oscal:Part ;
	skos:exactMatch nist_sp_800_53:AssessmentObjective ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:Sp80053Baseline a owl:Class ;
	rdfs:comment "One of the four control baselines SP 800-53B defines: the controls and enhancements selected for systems at the low, moderate or high impact level, or for privacy." ;
	rdfs:label "Sp80053Baseline" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-53B> ;
	rdfs:subClassOf _:c14n110 , _:c14n114 , _:c14n115 , _:c14n30 , _:c14n49 , _:c14n89 , _:c14n9 , _:c14n90 ;
	skos:broadMatch oscal:Profile ;
	skos:exactMatch nist_sp_800_53:Baseline ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:Sp80053BaselineLevel\#HIGH a owl:Class ;
	rdfs:comment "The baseline for a high-impact system." ;
	rdfs:label "HIGH" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053BaselineLevel .
nist_sp_800_53:Sp80053BaselineLevel\#LOW a owl:Class ;
	rdfs:comment "The baseline for a low-impact system." ;
	rdfs:label "LOW" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053BaselineLevel .
nist_sp_800_53:Sp80053BaselineLevel\#MODERATE a owl:Class ;
	rdfs:comment "The baseline for a moderate-impact system." ;
	rdfs:label "MODERATE" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053BaselineLevel .
nist_sp_800_53:Sp80053BaselineLevel\#PRIVACY a owl:Class ;
	rdfs:comment "The privacy baseline, which applies regardless of impact level." ;
	rdfs:label "PRIVACY" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053BaselineLevel .
nist_sp_800_53:Sp80053BaselineLevel a owl:Class ;
	rdfs:comment "The four control baselines SP 800-53B defines." ;
	rdfs:label "Sp80053BaselineLevel" ;
	owl:unionOf _:c14n133 ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> ;
	linkml:permissible_values nist_sp_800_53:Sp80053BaselineLevel\#HIGH , nist_sp_800_53:Sp80053BaselineLevel\#LOW , nist_sp_800_53:Sp80053BaselineLevel\#MODERATE , nist_sp_800_53:Sp80053BaselineLevel\#PRIVACY .
nist_sp_800_53:Sp80053Catalog a owl:Class ;
	rdfs:comment "One release of the control catalog as a whole: its families, each holding its controls and their enhancements, the baselines that select from them, and the publications the catalog lists." ;
	rdfs:label "Sp80053Catalog" ;
	rdfs:seeAlso <https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final> ;
	rdfs:subClassOf _:c14n119 , _:c14n139 , _:c14n145 , _:c14n164 , _:c14n169 , _:c14n177 , _:c14n38 , _:c14n46 , _:c14n64 ;
	skos:broadMatch oscal:Catalog ;
	skos:exactMatch nist_sp_800_53:Catalog ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:Sp80053Control a owl:Class ;
	rdfs:comment "A security or privacy control: a safeguard with an identifier, a statement of what it requires, a discussion, parameters the organization defines, related controls, references, the assessment objective and methods SP 800-53A gives it, and its enhancements. A control Revision 5 withdrew keeps its identifier and says where it went." ;
	rdfs:label "Sp80053Control" ;
	rdfs:seeAlso <https://csrc.nist.gov/projects/risk-management/sp800-53-controls> ;
	rdfs:subClassOf _:c14n104 , _:c14n107 , _:c14n11 , _:c14n116 , _:c14n118 , _:c14n122 , _:c14n13 , _:c14n137 , _:c14n144 , _:c14n147 , _:c14n148 , _:c14n152 , _:c14n157 , _:c14n158 , _:c14n159 , _:c14n16 , _:c14n163 , _:c14n17 , _:c14n170 , _:c14n171 , _:c14n172 , _:c14n174 , _:c14n19 , _:c14n2 , _:c14n28 , _:c14n32 , _:c14n4 , _:c14n41 , _:c14n42 , _:c14n43 , _:c14n50 , _:c14n61 , _:c14n66 , _:c14n67 , _:c14n69 , _:c14n70 , _:c14n72 , _:c14n83 , _:c14n85 , _:c14n88 ;
	skos:broadMatch oscal:Control ;
	skos:exactMatch nist_sp_800_53:Control ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:Sp80053ControlEnhancement a owl:Class ;
	rdfs:comment "A control enhancement: added functionality or strength for a control, with an identifier of its own, which the publication and other documents cite apart from the control. It carries what a control carries, and names the control or enhancement it requires." ;
	rdfs:label "Sp80053ControlEnhancement" ;
	rdfs:seeAlso <https://csrc.nist.gov/projects/risk-management/sp800-53-controls> ;
	rdfs:subClassOf _:c14n100 , _:c14n106 , _:c14n111 , _:c14n121 , _:c14n127 , _:c14n129 , _:c14n14 , _:c14n142 , _:c14n143 , _:c14n150 , _:c14n154 , _:c14n160 , _:c14n162 , _:c14n165 , _:c14n166 , _:c14n168 , _:c14n180 , _:c14n186 , _:c14n187 , _:c14n23 , _:c14n25 , _:c14n3 , _:c14n35 , _:c14n36 , _:c14n44 , _:c14n48 , _:c14n5 , _:c14n52 , _:c14n57 , _:c14n58 , _:c14n6 , _:c14n60 , _:c14n63 , _:c14n68 , _:c14n76 , _:c14n86 , _:c14n87 , _:c14n92 , _:c14n97 , _:c14n99 ;
	skos:broadMatch oscal:Control ;
	skos:exactMatch nist_sp_800_53:ControlEnhancement ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:Sp80053ControlStatus\#WITHDRAWN a owl:Class ;
	rdfs:comment "Revision 5 withdrew the control or enhancement; incorporated_into, moved_to or withdrawal_reason says where it went." ;
	rdfs:label "WITHDRAWN" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053ControlStatus .
nist_sp_800_53:Sp80053ControlStatus a owl:Class ;
	rdfs:comment "The one status the catalog marks: withdrawn. A control or enhancement that Revision 5 keeps carries no status." ;
	rdfs:label "Sp80053ControlStatus" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> ;
	linkml:permissible_values nist_sp_800_53:Sp80053ControlStatus\#WITHDRAWN .
nist_sp_800_53:Sp80053Family a owl:Class ;
	rdfs:comment "One of the twenty families SP 800-53 sorts its controls into, such as Access Control or Supply Chain Risk Management." ;
	rdfs:label "Sp80053Family" ;
	rdfs:seeAlso <https://csrc.nist.gov/projects/risk-management/sp800-53-controls> ;
	rdfs:subClassOf _:c14n102 , _:c14n124 , _:c14n125 , _:c14n128 , _:c14n179 , _:c14n20 , _:c14n27 , _:c14n53 , _:c14n54 , _:c14n7 , _:c14n78 ;
	skos:broadMatch oscal:Group ;
	skos:exactMatch nist_sp_800_53:Family ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:Sp80053ImplementationLevel\#ORGANIZATION a owl:Class ;
	rdfs:comment "The organization implements it, through its processes and people." ;
	rdfs:label "ORGANIZATION" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053ImplementationLevel .
nist_sp_800_53:Sp80053ImplementationLevel\#SYSTEM a owl:Class ;
	rdfs:comment "The system implements it, through its mechanisms." ;
	rdfs:label "SYSTEM" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053ImplementationLevel .
nist_sp_800_53:Sp80053ImplementationLevel a owl:Class ;
	rdfs:comment "Who implements a control or enhancement, as NIST's reference data marks it." ;
	rdfs:label "Sp80053ImplementationLevel" ;
	owl:unionOf _:c14n109 ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> ;
	linkml:permissible_values nist_sp_800_53:Sp80053ImplementationLevel\#ORGANIZATION , nist_sp_800_53:Sp80053ImplementationLevel\#SYSTEM .
nist_sp_800_53:Sp80053Parameter a owl:Class ;
	rdfs:comment "An organization-defined parameter: a value the control statement leaves to the organization, either an assignment the organization fills in or a selection from the choices the publication lists. SP 800-53A labels each parameter but the ones that aggregate others, and gives most a guideline." ;
	rdfs:label "Sp80053Parameter" ;
	rdfs:seeAlso <https://doi.org/10.6028/NIST.SP.800-53Ar5> ;
	rdfs:subClassOf _:c14n10 , _:c14n105 , _:c14n113 , _:c14n130 , _:c14n131 , _:c14n136 , _:c14n141 , _:c14n146 , _:c14n161 , _:c14n18 , _:c14n22 , _:c14n24 , _:c14n29 , _:c14n37 , _:c14n40 , _:c14n59 , _:c14n62 , _:c14n73 , _:c14n77 , _:c14n80 , _:c14n84 , _:c14n94 , _:c14n96 ;
	skos:broadMatch oscal:Parameter ;
	skos:exactMatch nist_sp_800_53:Parameter ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:Sp80053Reference a owl:Class ;
	rdfs:comment "A publication the catalog's references list, as they list it: its label, its citation and its address." ;
	rdfs:label "Sp80053Reference" ;
	rdfs:seeAlso <https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final> ;
	rdfs:subClassOf _:c14n132 , _:c14n134 , _:c14n149 , _:c14n167 , _:c14n182 , _:c14n183 , _:c14n185 , _:c14n21 , _:c14n26 ;
	skos:broadMatch oscal:Resource ;
	skos:exactMatch nist_sp_800_53:Reference ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:Sp80053SelectionCardinality\#ONE a owl:Class ;
	rdfs:comment "Exactly one choice, which the catalog leaves unwritten." ;
	rdfs:label "ONE" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053SelectionCardinality .
nist_sp_800_53:Sp80053SelectionCardinality\#ONE_OR_MORE a owl:Class ;
	rdfs:comment "One or more choices, which the publication writes as Selection (one or more)." ;
	rdfs:label "ONE_OR_MORE" ;
	rdfs:subClassOf nist_sp_800_53:Sp80053SelectionCardinality .
nist_sp_800_53:Sp80053SelectionCardinality a owl:Class ;
	rdfs:comment "How many of a selection's choices the organization picks." ;
	rdfs:label "Sp80053SelectionCardinality" ;
	owl:unionOf _:c14n39 ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> ;
	linkml:permissible_values nist_sp_800_53:Sp80053SelectionCardinality\#ONE , nist_sp_800_53:Sp80053SelectionCardinality\#ONE_OR_MORE .
nist_sp_800_53:Sp80053Statement a owl:Class ;
	rdfs:comment "A control statement: the text of what a control or enhancement requires, and the items it is divided into." ;
	rdfs:label "Sp80053Statement" ;
	rdfs:seeAlso <https://csrc.nist.gov/projects/risk-management/sp800-53-controls> ;
	rdfs:subClassOf _:c14n103 , _:c14n12 , _:c14n120 , _:c14n81 , _:c14n82 ;
	skos:broadMatch oscal:Part ;
	skos:exactMatch nist_sp_800_53:Statement ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:Sp80053StatementItem a owl:Class ;
	rdfs:comment "One lettered or numbered item of a control statement, which may hold items of its own." ;
	rdfs:label "Sp80053StatementItem" ;
	rdfs:seeAlso <https://csrc.nist.gov/projects/risk-management/sp800-53-controls> ;
	rdfs:subClassOf _:c14n0 , _:c14n117 , _:c14n126 , _:c14n155 , _:c14n31 , _:c14n45 , _:c14n51 , _:c14n91 ;
	skos:broadMatch oscal:Part ;
	skos:exactMatch nist_sp_800_53:StatementItem ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:aggregated_parameters a owl:DatatypeProperty ;
	rdfs:comment "For a parameter that stands for several, the parameters it aggregates, by identifier." ;
	rdfs:label "aggregated_parameters" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:alternative_identifiers a owl:DatatypeProperty ;
	rdfs:comment "The identifiers an earlier release of the catalog gave the parameter, such as ac-1_prm_2 for ac-01_odp.03." ;
	rdfs:label "alternative_identifiers" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:alternative_label a owl:DatatypeProperty ;
	rdfs:comment "The label SP 800-53 prints where it differs from the one SP 800-53A gives." ;
	rdfs:label "alternative_label" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:assessment_label a owl:DatatypeProperty ;
	rdfs:comment "The label SP 800-53A gives the parameter, such as AC-02_ODP[01]. A parameter that aggregates several has none." ;
	rdfs:label "assessment_label" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:assessment_method a owl:ObjectProperty ;
	rdfs:comment "Which of the three methods this is." ;
	rdfs:label "assessment_method" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:assessment_methods a owl:ObjectProperty ;
	rdfs:comment "The assessment methods SP 800-53A gives the control or enhancement, each with the objects it is applied to." ;
	rdfs:label "assessment_methods" ;
	rdfs:range nist_sp_800_53:Sp80053AssessmentMethod ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:assessment_objective a owl:ObjectProperty ;
	rdfs:comment "The assessment objective SP 800-53A gives the control or enhancement: the determination statements an assessor checks, nested as the statement's items are." ;
	rdfs:label "assessment_objective" ;
	rdfs:range nist_sp_800_53:Sp80053AssessmentObjective ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:assessment_objects a owl:DatatypeProperty ;
	rdfs:comment "The objects the method is applied to, in the order the publication lists them." ;
	rdfs:label "assessment_objects" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:baseline_controls a owl:DatatypeProperty ;
	rdfs:comment "The controls and enhancements the baseline selects, by identifier, in the order the catalog gives them." ;
	rdfs:label "baseline_controls" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:baseline_level a owl:ObjectProperty ;
	rdfs:comment "Which of the four baselines this is." ;
	rdfs:label "baseline_level" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:catalog_references a owl:ObjectProperty ;
	rdfs:comment "The publications the catalog's references list, most of which a control cites." ;
	rdfs:label "catalog_references" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:catalog_release a owl:DatatypeProperty ;
	rdfs:comment "The release of Revision 5 the catalog carries, as NIST numbers it, such as 5.2.0." ;
	rdfs:label "catalog_release" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:contributes_to_assurance a owl:DatatypeProperty ;
	rdfs:comment "True where NIST's reference data marks the control or enhancement as one that contributes to assurance; absent otherwise." ;
	rdfs:label "contributes_to_assurance" ;
	rdfs:range xsd:boolean ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:control_baselines a owl:ObjectProperty ;
	rdfs:comment "The control baselines of SP 800-53B that select from the catalog." ;
	rdfs:label "control_baselines" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:control_discussion a owl:DatatypeProperty ;
	rdfs:comment "The discussion that follows the statement: context and guidance that help apply the control, which the publication does not require." ;
	rdfs:label "control_discussion" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> ;
	skos:note "Where the catalog links a control or a statement item inside the text, a derivation keeps the link's text, which is the identifier as the publication prints it, and where it links a reference, the reference's label in brackets." .
nist_sp_800_53:control_enhancements a owl:ObjectProperty ;
	rdfs:comment "The control's enhancements. A knowledge bundle relates an enhancement to its control with isPartOf instead." ;
	rdfs:label "control_enhancements" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:control_families a owl:ObjectProperty ;
	rdfs:comment "The twenty control families, in the order SP 800-53 gives them." ;
	rdfs:label "control_families" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:control_identifier a owl:DatatypeProperty ;
	rdfs:comment "The control's identifier, such as AC-2." ;
	rdfs:label "control_identifier" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:control_parameters a owl:ObjectProperty ;
	rdfs:comment "The organization-defined parameters the statement leaves to the organization, in the order the catalog gives them." ;
	rdfs:label "control_parameters" ;
	rdfs:range nist_sp_800_53:Sp80053Parameter ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:control_references a owl:DatatypeProperty ;
	rdfs:comment "The publications the control or enhancement cites, by the labels the catalog's references carry, such as SP 800-12 or OMB A-130." ;
	rdfs:label "control_references" ;
	rdfs:range _:c14n56 ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:control_statement a owl:ObjectProperty ;
	rdfs:comment "The control statement: what the control or enhancement requires, as one text, a lettered or numbered list of items, or both." ;
	rdfs:label "control_statement" ;
	rdfs:range nist_sp_800_53:Sp80053Statement ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:control_status a owl:ObjectProperty ;
	rdfs:comment "The status the catalog gives a control or enhancement that Revision 5 withdrew. An active one carries none." ;
	rdfs:label "control_status" ;
	rdfs:range nist_sp_800_53:Sp80053ControlStatus ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:description a owl:DatatypeProperty ;
	rdfs:comment "What the family is about, in the words of whoever records it. SP 800-53 gives the Program Management family an overview of its own, and the other families none." ;
	rdfs:label "description" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." .
nist_sp_800_53:enhancement_id a owl:DatatypeProperty ;
	rdfs:comment "The enhancement's identifier, such as AC-2(1)." ;
	rdfs:label "enhancement_id" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:family_controls a owl:ObjectProperty ;
	rdfs:comment "The controls of the family. A knowledge bundle relates a control to its family with isPartOf instead." ;
	rdfs:label "family_controls" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:family_id a owl:DatatypeProperty ;
	rdfs:comment "The family's two letters, such as AC for Access Control." ;
	rdfs:label "family_id" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:implementation_level a owl:ObjectProperty ;
	rdfs:comment "Who implements the control or enhancement, as NIST's reference data marks it: the organization, the system, or both." ;
	rdfs:label "implementation_level" ;
	rdfs:range nist_sp_800_53:Sp80053ImplementationLevel ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:incorporated_into a owl:DatatypeProperty ;
	rdfs:comment "For a withdrawn control or enhancement, what it was incorporated into, as the publication states it." ;
	rdfs:label "incorporated_into" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:item_label a owl:DatatypeProperty ;
	rdfs:comment "The item's label as the publication prints it, such as a., 1. or (a)." ;
	rdfs:label "item_label" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:item_text a owl:DatatypeProperty ;
	rdfs:comment "The item's text, with the same placeholders for parameters as the statement's text." ;
	rdfs:label "item_text" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:moved_to a owl:DatatypeProperty ;
	rdfs:comment "For a withdrawn control or enhancement, the control or enhancement it moved to, as the publication states it." ;
	rdfs:label "moved_to" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:objective_label a owl:DatatypeProperty ;
	rdfs:comment "The label SP 800-53A gives the objective, such as AC-02a.[01]." ;
	rdfs:label "objective_label" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:objective_text a owl:DatatypeProperty ;
	rdfs:comment "The determination statement, with the same placeholders for parameters as the control statement. A heading has none." ;
	rdfs:label "objective_text" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:parameter_guidelines a owl:DatatypeProperty ;
	rdfs:comment "The guidelines that say what a value must settle, such as that the frequency of a review is defined." ;
	rdfs:label "parameter_guidelines" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:parameter_id a owl:DatatypeProperty ;
	rdfs:comment "The parameter's identifier in NIST's catalog, such as ac-02_odp.01." ;
	rdfs:label "parameter_id" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:parameter_label a owl:DatatypeProperty ;
	rdfs:comment "For an assignment, what the organization defines, such as personnel or roles." ;
	rdfs:label "parameter_label" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:reference_citation a owl:DatatypeProperty ;
	rdfs:comment "The citation, as the catalog prints it." ;
	rdfs:label "reference_citation" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:reference_label a owl:DatatypeProperty ;
	rdfs:comment "The label the controls cite the publication by, such as SP 800-12." ;
	rdfs:label "reference_label" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:reference_url a owl:DatatypeProperty ;
	rdfs:comment "The address the catalog gives for the publication." ;
	rdfs:label "reference_url" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:related_control_ids a owl:DatatypeProperty ;
	rdfs:comment "The controls and enhancements the publication lists as related, by identifier." ;
	rdfs:label "related_control_ids" ;
	rdfs:range xsd:string ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:required_controls a owl:DatatypeProperty ;
	rdfs:comment "The controls and enhancements that must be implemented for the enhancement to apply, as NIST's catalog links them: its own control, and for SC-42(2) also SC-42(1)." ;
	rdfs:label "required_controls" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:selection_cardinality a owl:ObjectProperty ;
	rdfs:comment "For a selection, how many choices the organization picks. The catalog marks one or more, and leaves the slot out when one choice is allowed, which is how OSCAL reads an absent how-many." ;
	rdfs:label "selection_cardinality" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:selection_choices a owl:DatatypeProperty ;
	rdfs:comment "For a selection, the choices the publication lists, in order." ;
	rdfs:label "selection_choices" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:statement_items a owl:ObjectProperty ;
	rdfs:comment "The lettered or numbered items of the statement, in order, each of which may hold items of its own." ;
	rdfs:label "statement_items" ;
	rdfs:range nist_sp_800_53:Sp80053StatementItem ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:statement_text a owl:DatatypeProperty ;
	rdfs:comment "The statement's own text, before any items. A placeholder of the form {{ insert: param, <identifier> }} marks where an organization-defined parameter is inserted." ;
	rdfs:label "statement_text" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:sub_objectives a owl:ObjectProperty ;
	rdfs:comment "The objectives grouped under this one, in order." ;
	rdfs:label "sub_objectives" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .
nist_sp_800_53:title a owl:DatatypeProperty ;
	rdfs:comment "The name SP 800-53 gives the family, control or control enhancement, or the title NIST's profile gives the baseline." ;
	rdfs:label "title" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> ;
	skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." .
nist_sp_800_53:withdrawal_reason a owl:DatatypeProperty ;
	rdfs:comment "For a withdrawn control or enhancement that the publication neither moved nor incorporated, what it says instead, such as that the enhancement is addressed through tailoring." ;
	rdfs:label "withdrawal_reason" ;
	skos:inScheme <https://w3id.org/lmodel/nist-sp-800-53> .

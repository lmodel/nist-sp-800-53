        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NodeIdentifier",
      "uri": "http://www.w3.org/ns/shex#nonLiteral",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpointer",
      "definition_uri": "https://w3id.org/linkml/Jsonpointer",
      "conforms_to": "https://datatracker.ietf.org/doc/html/rfc6901",
      "description": "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpath",
      "definition_uri": "https://w3id.org/linkml/Jsonpath",
      "conforms_to": "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html",
      "description": "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "sparqlpath",
      "definition_uri": "https://w3id.org/linkml/Sparqlpath",
      "conforms_to": "https://www.w3.org/TR/sparql11-query/#propertypaths",
      "description": "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "Sp80053ControlStatus",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlStatus",
      "description": "The one status the catalog marks: withdrawn. A control or enhancement that Revision 5 keeps carries no status.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "permissible_values": [
        {
          "text": "WITHDRAWN",
          "description": "Revision 5 withdrew the control or enhancement; incorporated_into, moved_to or withdrawal_reason says where it went."
        }
      ]
    },
    {
      "name": "Sp80053ImplementationLevel",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053ImplementationLevel",
      "description": "Who implements a control or enhancement, as NIST's reference data marks it.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "permissible_values": [
        {
          "text": "ORGANIZATION",
          "description": "The organization implements it, through its processes and people."
        },
        {
          "text": "SYSTEM",
          "description": "The system implements it, through its mechanisms."
        }
      ]
    },
    {
      "name": "Sp80053SelectionCardinality",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053SelectionCardinality",
      "description": "How many of a selection's choices the organization picks.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "permissible_values": [
        {
          "text": "ONE",
          "description": "Exactly one choice, which the catalog leaves unwritten."
        },
        {
          "text": "ONE_OR_MORE",
          "description": "One or more choices, which the publication writes as Selection (one or more)."
        }
      ]
    },
    {
      "name": "Sp80053AssessmentMethodKind",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053AssessmentMethodKind",
      "description": "The three assessment methods of SP 800-53A, as its catalog writes them.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "permissible_values": [
        {
          "text": "EXAMINE",
          "description": "Review, inspect, observe, study or analyze specifications, mechanisms or activities."
        },
        {
          "text": "INTERVIEW",
          "description": "Hold discussions with individuals or groups."
        },
        {
          "text": "TEST",
          "description": "Exercise mechanisms or activities under specified conditions."
        }
      ]
    },
    {
      "name": "Sp80053BaselineLevel",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053BaselineLevel",
      "description": "The four control baselines SP 800-53B defines.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "permissible_values": [
        {
          "text": "LOW",
          "description": "The baseline for a low-impact system."
        },
        {
          "text": "MODERATE",
          "description": "The baseline for a moderate-impact system."
        },
        {
          "text": "HIGH",
          "description": "The baseline for a high-impact system."
        },
        {
          "text": "PRIVACY",
          "description": "The privacy baseline, which applies regardless of impact level."
        }
      ]
    }
  ],
  "slots": [
    {
      "name": "title",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/title",
      "description": "The name SP 800-53 gives the family, control or control enhancement, or the title NIST's profile gives the baseline.",
      "comments": [
        "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "mappings": [
        "http://schema.org/name"
      ],
      "slot_uri": "http://schema.org/name",
      "owner": "Sp80053Baseline",
      "domain_of": [
        "Sp80053Family",
        "Sp80053Control",
        "Sp80053ControlEnhancement",
        "Sp80053Baseline"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "description",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/description",
      "description": "What the family is about, in the words of whoever records it. SP 800-53 gives the Program Management family an overview of its own, and the other families none.",
      "comments": [
        "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "mappings": [
        "http://schema.org/description"
      ],
      "slot_uri": "http://schema.org/description",
      "owner": "Sp80053Family",
      "domain_of": [
        "Sp80053Family"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "family_id",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/family_id",
      "description": "The family's two letters, such as AC for Access Control.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/family_id",
      "owner": "Sp80053Family",
      "domain_of": [
        "Sp80053Family"
      ],
      "range": "sp80053_family_identifier",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "control_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_identifier",
      "description": "The control's identifier, such as AC-2.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_identifier",
      "owner": "Sp80053Control",
      "domain_of": [
        "Sp80053Control"
      ],
      "range": "sp80053_control_identifier",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "enhancement_id",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/enhancement_id",
      "description": "The enhancement's identifier, such as AC-2(1).",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/enhancement_id",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053ControlEnhancement"
      ],
      "range": "sp80053_enhancement_identifier",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "baseline_level",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/baseline_level",
      "description": "Which of the four baselines this is.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/baseline_level",
      "owner": "Sp80053Baseline",
      "domain_of": [
        "Sp80053Baseline"
      ],
      "range": "Sp80053BaselineLevel",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "control_statement",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_statement",
      "description": "The control statement: what the control or enhancement requires, as one text, a lettered or numbered list of items, or both.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_statement",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "Sp80053Statement",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "control_discussion",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_discussion",
      "description": "The discussion that follows the statement: context and guidance that help apply the control, which the publication does not require.",
      "comments": [
        "Where the catalog links a control or a statement item inside the text, a derivation keeps the link's text, which is the identifier as the publication prints it, and where it links a reference, the reference's label in brackets."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_discussion",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "control_parameters",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_parameters",
      "description": "The organization-defined parameters the statement leaves to the organization, in the order the catalog gives them.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_parameters",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "Sp80053Parameter",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "related_control_ids",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/related_control_ids",
      "description": "The controls and enhancements the publication lists as related, by identifier.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/related_control_ids",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "sp80053_control_or_enhancement_identifier",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "control_references",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_references",
      "description": "The publications the control or enhancement cites, by the labels the catalog's references carry, such as SP 800-12 or OMB A-130.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_references",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "string",
      "multivalued": true,
      "pattern": "^\\s*\\S",
      "@type": "SlotDefinition"
    },
    {
      "name": "assessment_objective",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/assessment_objective",
      "description": "The assessment objective SP 800-53A gives the control or enhancement: the determination statements an assessor checks, nested as the statement's items are.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/assessment_objective",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "Sp80053AssessmentObjective",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "assessment_methods",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/assessment_methods",
      "description": "The assessment methods SP 800-53A gives the control or enhancement, each with the objects it is applied to.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/assessment_methods",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "Sp80053AssessmentMethod",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "control_status",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_status",
      "description": "The status the catalog gives a control or enhancement that Revision 5 withdrew. An active one carries none.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_status",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "Sp80053ControlStatus",
      "@type": "SlotDefinition"
    },
    {
      "name": "incorporated_into",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/incorporated_into",
      "description": "For a withdrawn control or enhancement, what it was incorporated into, as the publication states it.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/incorporated_into",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "sp80053_withdrawal_target",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "moved_to",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/moved_to",
      "description": "For a withdrawn control or enhancement, the control or enhancement it moved to, as the publication states it.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/moved_to",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "sp80053_control_or_enhancement_identifier",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "withdrawal_reason",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/withdrawal_reason",
      "description": "For a withdrawn control or enhancement that the publication neither moved nor incorporated, what it says instead, such as that the enhancement is addressed through tailoring.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/withdrawal_reason",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "implementation_level",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/implementation_level",
      "description": "Who implements the control or enhancement, as NIST's reference data marks it: the organization, the system, or both.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/implementation_level",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "Sp80053ImplementationLevel",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "contributes_to_assurance",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/contributes_to_assurance",
      "description": "True where NIST's reference data marks the control or enhancement as one that contributes to assurance; absent otherwise.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/contributes_to_assurance",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053Control",
        "Sp80053ControlEnhancement"
      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
    {
      "name": "statement_items",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/statement_items",
      "description": "The lettered or numbered items of the statement, in order, each of which may hold items of its own.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/statement_items",
      "owner": "Sp80053StatementItem",
      "domain_of": [
        "Sp80053Statement",
        "Sp80053StatementItem"
      ],
      "range": "Sp80053StatementItem",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Catalog__catalog_release",
      "description": "The release of Revision 5 the catalog carries, as NIST numbers it, such as 5.2.0.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/catalog_release",
      "alias": "catalog_release",
      "owner": "Sp80053Catalog",
      "domain_of": [
        "Sp80053Catalog"
      ],
      "range": "string",
      "required": true,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Catalog__control_families",
      "description": "The twenty control families, in the order SP 800-53 gives them.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_families",
      "alias": "control_families",
      "owner": "Sp80053Catalog",
      "domain_of": [
        "Sp80053Catalog"
      ],
      "range": "Sp80053Family",
      "required": true,
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Catalog__control_baselines",
      "description": "The control baselines of SP 800-53B that select from the catalog.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_baselines",
      "alias": "control_baselines",
      "owner": "Sp80053Catalog",
      "domain_of": [
        "Sp80053Catalog"
      ],
      "range": "Sp80053Baseline",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Catalog__catalog_references",
      "description": "The publications the catalog's references list, most of which a control cites.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/catalog_references",
      "alias": "catalog_references",
      "owner": "Sp80053Catalog",
      "domain_of": [
        "Sp80053Catalog"
      ],
      "range": "Sp80053Reference",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Family__family_controls",
      "description": "The controls of the family. A knowledge bundle relates a control to its family with isPartOf instead.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/family_controls",
      "alias": "family_controls",
      "owner": "Sp80053Family",
      "domain_of": [
        "Sp80053Family"
      ],
      "range": "Sp80053Control",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Control__control_enhancements",
      "description": "The control's enhancements. A knowledge bundle relates an enhancement to its control with isPartOf instead.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/control_enhancements",
      "alias": "control_enhancements",
      "owner": "Sp80053Control",
      "domain_of": [
        "Sp80053Control"
      ],
      "range": "Sp80053ControlEnhancement",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053ControlEnhancement__required_controls",
      "description": "The controls and enhancements that must be implemented for the enhancement to apply, as NIST's catalog links them: its own control, and for SC-42(2) also SC-42(1).",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/required_controls",
      "alias": "required_controls",
      "owner": "Sp80053ControlEnhancement",
      "domain_of": [
        "Sp80053ControlEnhancement"
      ],
      "range": "sp80053_control_or_enhancement_identifier",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Statement__statement_text",
      "description": "The statement's own text, before any items. A placeholder of the form {{ insert: param, <identifier> }} marks where an organization-defined parameter is inserted.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/statement_text",
      "alias": "statement_text",
      "owner": "Sp80053Statement",
      "domain_of": [
        "Sp80053Statement"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053StatementItem__item_label",
      "description": "The item's label as the publication prints it, such as a., 1. or (a).",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/item_label",
      "alias": "item_label",
      "owner": "Sp80053StatementItem",
      "domain_of": [
        "Sp80053StatementItem"
      ],
      "range": "string",
      "required": true,
      "pattern": "^(([a-z]|[1-9][0-9]*)\\.|\\(([a-z]|[1-9][0-9]*)\\))$",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053StatementItem__item_text",
      "description": "The item's text, with the same placeholders for parameters as the statement's text.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/item_text",
      "alias": "item_text",
      "owner": "Sp80053StatementItem",
      "domain_of": [
        "Sp80053StatementItem"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Parameter__parameter_id",
      "description": "The parameter's identifier in NIST's catalog, such as ac-02_odp.01.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/parameter_id",
      "alias": "parameter_id",
      "owner": "Sp80053Parameter",
      "domain_of": [
        "Sp80053Parameter"
      ],
      "range": "sp80053_parameter_identifier",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Parameter__assessment_label",
      "description": "The label SP 800-53A gives the parameter, such as AC-02_ODP[01]. A parameter that aggregates several has none.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/assessment_label",
      "alias": "assessment_label",
      "owner": "Sp80053Parameter",
      "domain_of": [
        "Sp80053Parameter"
      ],
      "range": "string",
      "pattern": "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)-[0-9]{2}(\\([0-9]{2}\\)|\\.[0-9]{2})?_ODP(\\[[0-9]{2}\\])?$",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Parameter__parameter_label",
      "description": "For an assignment, what the organization defines, such as personnel or roles.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/parameter_label",
      "alias": "parameter_label",
      "owner": "Sp80053Parameter",
      "domain_of": [
        "Sp80053Parameter"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Parameter__parameter_guidelines",
      "description": "The guidelines that say what a value must settle, such as that the frequency of a review is defined.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/parameter_guidelines",
      "alias": "parameter_guidelines",
      "owner": "Sp80053Parameter",
      "domain_of": [
        "Sp80053Parameter"
      ],
      "range": "string",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Parameter__selection_choices",
      "description": "For a selection, the choices the publication lists, in order.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/selection_choices",
      "alias": "selection_choices",
      "owner": "Sp80053Parameter",
      "domain_of": [
        "Sp80053Parameter"
      ],
      "range": "string",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Parameter__selection_cardinality",
      "description": "For a selection, how many choices the organization picks. The catalog marks one or more, and leaves the slot out when one choice is allowed, which is how OSCAL reads an absent how-many.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/selection_cardinality",
      "alias": "selection_cardinality",
      "owner": "Sp80053Parameter",
      "domain_of": [
        "Sp80053Parameter"
      ],
      "range": "Sp80053SelectionCardinality",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Parameter__aggregated_parameters",
      "description": "For a parameter that stands for several, the parameters it aggregates, by identifier.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/aggregated_parameters",
      "alias": "aggregated_parameters",
      "owner": "Sp80053Parameter",
      "domain_of": [
        "Sp80053Parameter"
      ],
      "range": "sp80053_parameter_identifier",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Parameter__alternative_identifiers",
      "description": "The identifiers an earlier release of the catalog gave the parameter, such as ac-1_prm_2 for ac-01_odp.03.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/alternative_identifiers",
      "alias": "alternative_identifiers",
      "owner": "Sp80053Parameter",
      "domain_of": [
        "Sp80053Parameter"
      ],
      "range": "sp80053_parameter_identifier",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Parameter__alternative_label",
      "description": "The label SP 800-53 prints where it differs from the one SP 800-53A gives.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/alternative_label",
      "alias": "alternative_label",
      "owner": "Sp80053Parameter",
      "domain_of": [
        "Sp80053Parameter"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053AssessmentObjective__objective_label",
      "description": "The label SP 800-53A gives the objective, such as AC-02a.[01].",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/objective_label",
      "alias": "objective_label",
      "owner": "Sp80053AssessmentObjective",
      "domain_of": [
        "Sp80053AssessmentObjective"
      ],
      "range": "string",
      "required": true,
      "pattern": "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)-[0-9]{2}(\\([0-9]{2}\\))?([a-z]\\.([0-9]{2})?)?(\\([a-z]\\)(\\([0-9]{2}\\))?)?(\\[[0-9]{2}\\])*$",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053AssessmentObjective__objective_text",
      "description": "The determination statement, with the same placeholders for parameters as the control statement. A heading has none.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/objective_text",
      "alias": "objective_text",
      "owner": "Sp80053AssessmentObjective",
      "domain_of": [
        "Sp80053AssessmentObjective"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053AssessmentObjective__sub_objectives",
      "description": "The objectives grouped under this one, in order.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/sub_objectives",
      "alias": "sub_objectives",
      "owner": "Sp80053AssessmentObjective",
      "domain_of": [
        "Sp80053AssessmentObjective"
      ],
      "range": "Sp80053AssessmentObjective",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053AssessmentMethod__assessment_method",
      "description": "Which of the three methods this is.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/assessment_method",
      "alias": "assessment_method",
      "owner": "Sp80053AssessmentMethod",
      "domain_of": [
        "Sp80053AssessmentMethod"
      ],
      "range": "Sp80053AssessmentMethodKind",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053AssessmentMethod__assessment_objects",
      "description": "The objects the method is applied to, in the order the publication lists them.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/assessment_objects",
      "alias": "assessment_objects",
      "owner": "Sp80053AssessmentMethod",
      "domain_of": [
        "Sp80053AssessmentMethod"
      ],
      "range": "string",
      "required": true,
      "multivalued": true,
      "pattern": "^\\s*\\S",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Reference__reference_label",
      "description": "The label the controls cite the publication by, such as SP 800-12.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/reference_label",
      "alias": "reference_label",
      "owner": "Sp80053Reference",
      "domain_of": [
        "Sp80053Reference"
      ],
      "range": "string",
      "required": true,
      "pattern": "^\\s*\\S",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Reference__reference_citation",
      "description": "The citation, as the catalog prints it.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/reference_citation",
      "alias": "reference_citation",
      "owner": "Sp80053Reference",
      "domain_of": [
        "Sp80053Reference"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Reference__reference_url",
      "description": "The address the catalog gives for the publication.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/reference_url",
      "alias": "reference_url",
      "owner": "Sp80053Reference",
      "domain_of": [
        "Sp80053Reference"
      ],
      "range": "uri",
      "@type": "SlotDefinition"
    },
    {
      "name": "sp80053Baseline__baseline_controls",
      "description": "The controls and enhancements the baseline selects, by identifier, in the order the catalog gives them.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "slot_uri": "https://w3id.org/lmodel/nist-sp-800-53/baseline_controls",
      "alias": "baseline_controls",
      "owner": "Sp80053Baseline",
      "domain_of": [
        "Sp80053Baseline"
      ],
      "range": "sp80053_control_or_enhancement_identifier",
      "required": true,
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "Sp80053Family_title",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/title",
      "description": "The name SP 800-53 gives the family, control or control enhancement, or the title NIST's profile gives the baseline.",
      "comments": [
        "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "mappings": [
        "http://schema.org/name"
      ],
      "is_a": "title",
      "domain": "Sp80053Family",
      "slot_uri": "http://schema.org/name",
      "alias": "title",
      "owner": "Sp80053Family",
      "domain_of": [
        "Sp80053Family"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "title",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "Sp80053Control_title",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/title",
      "description": "The name SP 800-53 gives the family, control or control enhancement, or the title NIST's profile gives the baseline.",
      "comments": [
        "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "mappings": [
        "http://schema.org/name"
      ],
      "is_a": "title",
      "domain": "Sp80053Control",
      "slot_uri": "http://schema.org/name",
      "alias": "title",
      "owner": "Sp80053Control",
      "domain_of": [
        "Sp80053Control"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "title",
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "Sp80053ControlEnhancement_title",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/title",
      "description": "The name SP 800-53 gives the family, control or control enhancement, or the title NIST's profile gives the baseline.",
      "comments": [
        "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "mappings": [
        "http://schema.org/name"
      ],
      "is_a": "title",

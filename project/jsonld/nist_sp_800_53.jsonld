      "prefix_prefix": "xsd",
      "prefix_reference": "http://www.w3.org/2001/XMLSchema#"
    }
  ],
  "default_prefix": "nist_sp_800_53",
  "default_range": "string",
  "types": [
    {
      "name": "sp80053_family_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053FamilyIdentifier",
      "description": "The two letters that name one of the twenty control families, such as AC for Access Control.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)$",
      "@type": "TypeDefinition"
    },
    {
      "name": "sp80053_control_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlIdentifier",
      "description": "A control's identifier: its family's letters, a hyphen and the control's number within the family, such as AC-2.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)-[1-9][0-9]*$",
      "@type": "TypeDefinition"
    },
    {
      "name": "sp80053_enhancement_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053EnhancementIdentifier",
      "description": "A control enhancement's identifier: its control's identifier and the enhancement's number in parentheses, such as AC-2(1).",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)-[1-9][0-9]*\\([1-9][0-9]*\\)$",
      "@type": "TypeDefinition"
    },
    {
      "name": "sp80053_control_or_enhancement_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlOrEnhancementIdentifier",
      "description": "The identifier of a control or of a control enhancement, such as AC-2 or AC-2(1), where the publication cites either.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)-[1-9][0-9]*(\\([1-9][0-9]*\\))?$",
      "@type": "TypeDefinition"
    },
    {
      "name": "sp80053_withdrawal_target",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053WithdrawalTarget",
      "description": "Where a withdrawn control or enhancement was incorporated, as the publication names it: a control or enhancement, such as AC-2 or AC-2(1), one item of a control's statement, such as AC-2k, or a whole family, such as SR.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)(-[1-9][0-9]*(\\([1-9][0-9]*\\))?([a-z](\\.[1-9][0-9]*)*|\\([a-z]\\)(\\([1-9][0-9]*\\))*)?)?$",
      "@type": "TypeDefinition"
    },
    {
      "name": "sp80053_parameter_identifier",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053ParameterIdentifier",
      "description": "The identifier NIST's catalog gives an organization-defined parameter, in lower case: the zero-padded control identifier, _odp and the parameter's number, such as ac-02_odp.01, or, for a parameter that aggregates several, the control identifier, _prm_ and a number, such as ac-1_prm_1.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "pattern": "^[a-z]{2}-[0-9]{2}(\\.[0-9]{2})?_odp(\\.[0-9]{2})?$|^[a-z]{2}-[1-9][0-9]*(\\.[1-9][0-9]*)?_prm_[1-9][0-9]*$",
      "@type": "TypeDefinition"
    },
    {
      "name": "string",
      "definition_uri": "https://w3id.org/linkml/String",
      "description": "A character string",
      "notes": [
        "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"."
      ],

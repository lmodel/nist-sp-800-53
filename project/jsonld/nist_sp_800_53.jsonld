  "classes": [
    {
      "name": "Sp80053Catalog",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053Catalog",
      "description": "One release of the control catalog as a whole: its families, each holding its controls and their enhancements, the baselines that select from them, and the publications the catalog lists.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "see_also": [
        "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final"
      ],
      "exact_mappings": [
        "nist_sp_800_53:Catalog"
      ],
      "broad_mappings": [
        "oscal:Catalog"
      ],
      "slots": [
        "sp80053Catalog__catalog_release",
        "sp80053Catalog__control_families",
        "sp80053Catalog__control_baselines",
        "sp80053Catalog__catalog_references"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "catalog_release",
          "description": "The release of Revision 5 the catalog carries, as NIST numbers it, such as 5.2.0.",
          "required": true,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "@type": "SlotDefinition"
        },
        {
          "name": "control_families",
          "description": "The twenty control families, in the order SP 800-53 gives them.",
          "range": "Sp80053Family",
          "required": true,
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "control_baselines",
          "description": "The control baselines of SP 800-53B that select from the catalog.",
          "range": "Sp80053Baseline",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "catalog_references",
          "description": "The publications the catalog's references list, most of which a control cites.",
          "range": "Sp80053Reference",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-53/Catalog",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp80053Family",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053Family",
      "description": "One of the twenty families SP 800-53 sorts its controls into, such as Access Control or Supply Chain Risk Management.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "see_also": [
        "https://csrc.nist.gov/projects/risk-management/sp800-53-controls"
      ],
      "exact_mappings": [
        "nist_sp_800_53:Family"
      ],
      "broad_mappings": [
        "oscal:Group"
      ],
      "slots": [
        "family_id",
        "Sp80053Family_title",
        "description",
        "sp80053Family__family_controls"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "family_controls",
          "description": "The controls of the family. A knowledge bundle relates a control to its family with isPartOf instead.",
          "range": "Sp80053Control",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-53/Family",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp80053Control",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control",
      "description": "A security or privacy control: a safeguard with an identifier, a statement of what it requires, a discussion, parameters the organization defines, related controls, references, the assessment objective and methods SP 800-53A gives it, and its enhancements. A control Revision 5 withdrew keeps its identifier and says where it went.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "see_also": [
        "https://csrc.nist.gov/projects/risk-management/sp800-53-controls"
      ],
      "exact_mappings": [
        "nist_sp_800_53:Control"
      ],
      "broad_mappings": [
        "oscal:Control"
      ],
      "slots": [
        "control_identifier",
        "Sp80053Control_title",
        "control_statement",
        "control_discussion",
        "control_parameters",
        "related_control_ids",
        "control_references",
        "assessment_objective",
        "assessment_methods",
        "control_status",
        "incorporated_into",
        "moved_to",
        "withdrawal_reason",
        "implementation_level",
        "contributes_to_assurance",
        "sp80053Control__control_enhancements"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "control_enhancements",
          "description": "The control's enhancements. A knowledge bundle relates an enhancement to its control with isPartOf instead.",
          "range": "Sp80053ControlEnhancement",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-53/Control",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp80053ControlEnhancement",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement",
      "description": "A control enhancement: added functionality or strength for a control, with an identifier of its own, which the publication and other documents cite apart from the control. It carries what a control carries, and names the control or enhancement it requires.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "see_also": [
        "https://csrc.nist.gov/projects/risk-management/sp800-53-controls"
      ],
      "exact_mappings": [
        "nist_sp_800_53:ControlEnhancement"
      ],
      "broad_mappings": [
        "oscal:Control"
      ],
      "slots": [
        "enhancement_id",
        "Sp80053ControlEnhancement_title",
        "control_statement",
        "control_discussion",
        "control_parameters",
        "related_control_ids",
        "control_references",
        "assessment_objective",
        "assessment_methods",
        "control_status",
        "incorporated_into",
        "moved_to",
        "withdrawal_reason",
        "implementation_level",
        "contributes_to_assurance",
        "sp80053ControlEnhancement__required_controls"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "required_controls",
          "description": "The controls and enhancements that must be implemented for the enhancement to apply, as NIST's catalog links them: its own control, and for SC-42(2) also SC-42(1).",
          "range": "sp80053_control_or_enhancement_identifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-53/ControlEnhancement",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp80053Statement",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053Statement",
      "description": "A control statement: the text of what a control or enhancement requires, and the items it is divided into.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "see_also": [
        "https://csrc.nist.gov/projects/risk-management/sp800-53-controls"
      ],
      "exact_mappings": [
        "nist_sp_800_53:Statement"
      ],
      "broad_mappings": [
        "oscal:Part"
      ],
      "slots": [
        "statement_items",
        "sp80053Statement__statement_text"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "statement_text",
          "description": "The statement's own text, before any items. A placeholder of the form {{ insert: param, <identifier> }} marks where an organization-defined parameter is inserted.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-53/Statement",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp80053StatementItem",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053StatementItem",
      "description": "One lettered or numbered item of a control statement, which may hold items of its own.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "see_also": [
        "https://csrc.nist.gov/projects/risk-management/sp800-53-controls"
      ],
      "exact_mappings": [
        "nist_sp_800_53:StatementItem"
      ],
      "broad_mappings": [
        "oscal:Part"
      ],
      "slots": [
        "statement_items",
        "sp80053StatementItem__item_label",
        "sp80053StatementItem__item_text"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "item_label",
          "description": "The item's label as the publication prints it, such as a., 1. or (a).",
          "required": true,
          "pattern": "^(([a-z]|[1-9][0-9]*)\\.|\\(([a-z]|[1-9][0-9]*)\\))$",
          "@type": "SlotDefinition"
        },
        {
          "name": "item_text",
          "description": "The item's text, with the same placeholders for parameters as the statement's text.",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-53/StatementItem",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp80053Parameter",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053Parameter",
      "description": "An organization-defined parameter: a value the control statement leaves to the organization, either an assignment the organization fills in or a selection from the choices the publication lists. SP 800-53A labels each parameter but the ones that aggregate others, and gives most a guideline.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "see_also": [
        "https://doi.org/10.6028/NIST.SP.800-53Ar5"
      ],
      "exact_mappings": [
        "nist_sp_800_53:Parameter"
      ],
      "broad_mappings": [
        "oscal:Parameter"
      ],
      "slots": [
        "sp80053Parameter__parameter_id",
        "sp80053Parameter__assessment_label",
        "sp80053Parameter__parameter_label",
        "sp80053Parameter__parameter_guidelines",
        "sp80053Parameter__selection_choices",
        "sp80053Parameter__selection_cardinality",
        "sp80053Parameter__aggregated_parameters",
        "sp80053Parameter__alternative_identifiers",
        "sp80053Parameter__alternative_label"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "parameter_id",
          "description": "The parameter's identifier in NIST's catalog, such as ac-02_odp.01.",
          "range": "sp80053_parameter_identifier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "assessment_label",
          "description": "The label SP 800-53A gives the parameter, such as AC-02_ODP[01]. A parameter that aggregates several has none.",
          "pattern": "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)-[0-9]{2}(\\([0-9]{2}\\)|\\.[0-9]{2})?_ODP(\\[[0-9]{2}\\])?$",
          "@type": "SlotDefinition"
        },
        {
          "name": "parameter_label",
          "description": "For an assignment, what the organization defines, such as personnel or roles.",
          "@type": "SlotDefinition"
        },
        {
          "name": "parameter_guidelines",
          "description": "The guidelines that say what a value must settle, such as that the frequency of a review is defined.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "selection_choices",
          "description": "For a selection, the choices the publication lists, in order.",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "selection_cardinality",
          "description": "For a selection, how many choices the organization picks. The catalog marks one or more, and leaves the slot out when one choice is allowed, which is how OSCAL reads an absent how-many.",
          "range": "Sp80053SelectionCardinality",
          "@type": "SlotDefinition"
        },
        {
          "name": "aggregated_parameters",
          "description": "For a parameter that stands for several, the parameters it aggregates, by identifier.",
          "range": "sp80053_parameter_identifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "alternative_identifiers",
          "description": "The identifiers an earlier release of the catalog gave the parameter, such as ac-1_prm_2 for ac-01_odp.03.",
          "range": "sp80053_parameter_identifier",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "alternative_label",
          "description": "The label SP 800-53 prints where it differs from the one SP 800-53A gives.",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-sp-800-53/Parameter",
      "@type": "ClassDefinition"
    },
    {
      "name": "Sp80053AssessmentObjective",
      "definition_uri": "https://w3id.org/lmodel/nist-sp-800-53/Sp80053AssessmentObjective",
      "description": "An assessment objective of SP 800-53A: a determination statement an assessor checks, or a heading that groups the determination statements of one item of the control statement.",
      "from_schema": "https://w3id.org/lmodel/nist-sp-800-53",
      "see_also": [

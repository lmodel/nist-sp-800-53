<https://w3id.org/lmodel/nist-sp-800-53/nist_sp_800_53> dcterms:license "Apache-2.0" ;
	dcterms:source "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI ;
	dcterms:title "NIST SP 800-53 Security and Privacy Controls, Release 5.2.0" ;
	pav:version "5.2.0" ;
	a linkml:SchemaDefinition ;
	rdfs:seeAlso "https://csrc.nist.gov/News/2025/nist-releases-revision-to-sp-800-53-controls"^^xsd:anyURI , "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final"^^xsd:anyURI , "https://doi.org/10.6028/NIST.SP.800-53Ar5"^^xsd:anyURI , "https://doi.org/10.6028/NIST.SP.800-53B"^^xsd:anyURI , "https://github.com/usnistgov/oscal-content/tree/v1.6.0/nist.gov/SP800-53/rev5"^^xsd:anyURI , "https://lmodel.github.io/nist-sp-800-53"^^xsd:anyURI ;
	skos:note "NIST's catalog renders each family as an OSCAL group, each control and control enhancement as an OSCAL control, each statement, discussion, assessment objective and assessment method as a part, each organization-defined parameter as a parameter, each reference as a back-matter resource, and each baseline as a profile. The broad_mappings name those lmodel/oscal classes." , "SP 800-53, SP 800-53A and SP 800-53B are works of the United States Government and are not subject to copyright in the United States. The descriptions here are this project's own words; NIST's text of each control, parameter, objective and method stays in the catalog copy." , "The version is the release of Revision 5 that the catalog carries, 5.2.0 of August 2025, and publication_date is that release's date; Revision 5 itself was published in September 2020 and updated in December 2020. source is the publication's digital object identifier. NIST's Cybersecurity and Privacy Reference Tool names the same release SP_800_53_5_2_0, and the catalog and the four baseline profiles NIST publishes for it in usnistgov/oscal-content are copied to src/nist_sp_800_53/schema/oscal-content/ at the tag and commit in the annotations. scripts/check_upstream_release.py reads the same pins and reports when NIST publishes a newer edition or changes a copied file. The release tags are the schema's own versions." ;
	sh:declare _:c14n11 , _:c14n13 , _:c14n14 , _:c14n3 , _:c14n6 ;
	linkml:annotations _:c14n10 , _:c14n12 , _:c14n4 , _:c14n5 ;
	linkml:classes <https://w3id.org/lmodel/nist-sp-800-53/Sp80053AssessmentMethod> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053AssessmentObjective> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Baseline> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Catalog> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Family> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Parameter> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Reference> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Statement> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053StatementItem> ;
	linkml:default_prefix "nist_sp_800_53" ;
	linkml:default_range <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:description "A LinkML model of the security and privacy controls that NIST Special Publication 800-53, Revision 5, defines at Release 5.2.0: its twenty control families, their controls and control enhancements, each with its statement, discussion, organization-defined parameters, related controls and references; the assessment objectives and methods that SP 800-53A gives each control; and the four control baselines of SP 800-53B." ;
	linkml:enums <https://w3id.org/lmodel/nist-sp-800-53/Sp80053AssessmentMethodKind> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053BaselineLevel> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlStatus> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ImplementationLevel> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053SelectionCardinality> ;
	linkml:id "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:imports "linkml:types"^^xsd:anyURI ;
	linkml:metamodel_version "1.12.0" ;
	linkml:slots <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Baseline_title> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement_title> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control_title> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Family_title> , <https://w3id.org/lmodel/nist-sp-800-53/assessment_methods> , <https://w3id.org/lmodel/nist-sp-800-53/assessment_objective> , <https://w3id.org/lmodel/nist-sp-800-53/baseline_level> , <https://w3id.org/lmodel/nist-sp-800-53/contributes_to_assurance> , <https://w3id.org/lmodel/nist-sp-800-53/control_discussion> , <https://w3id.org/lmodel/nist-sp-800-53/control_identifier> , <https://w3id.org/lmodel/nist-sp-800-53/control_parameters> , <https://w3id.org/lmodel/nist-sp-800-53/control_references> , <https://w3id.org/lmodel/nist-sp-800-53/control_statement> , <https://w3id.org/lmodel/nist-sp-800-53/control_status> , <https://w3id.org/lmodel/nist-sp-800-53/description> , <https://w3id.org/lmodel/nist-sp-800-53/enhancement_id> , <https://w3id.org/lmodel/nist-sp-800-53/family_id> , <https://w3id.org/lmodel/nist-sp-800-53/implementation_level> , <https://w3id.org/lmodel/nist-sp-800-53/incorporated_into> , <https://w3id.org/lmodel/nist-sp-800-53/moved_to> , <https://w3id.org/lmodel/nist-sp-800-53/related_control_ids> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053AssessmentMethod__assessment_method> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053AssessmentMethod__assessment_objects> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053AssessmentObjective__objective_label> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053AssessmentObjective__objective_text> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053AssessmentObjective__sub_objectives> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Baseline__baseline_controls> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Catalog__catalog_references> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Catalog__catalog_release> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Catalog__control_baselines> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Catalog__control_families> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053ControlEnhancement__required_controls> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Control__control_enhancements> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Family__family_controls> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Parameter__aggregated_parameters> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Parameter__alternative_identifiers> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Parameter__alternative_label> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Parameter__assessment_label> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Parameter__parameter_guidelines> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Parameter__parameter_id> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Parameter__parameter_label> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Parameter__selection_cardinality> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Parameter__selection_choices> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Reference__reference_citation> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Reference__reference_label> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Reference__reference_url> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053StatementItem__item_label> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053StatementItem__item_text> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Statement__statement_text> , <https://w3id.org/lmodel/nist-sp-800-53/statement_items> , <https://w3id.org/lmodel/nist-sp-800-53/title> , <https://w3id.org/lmodel/nist-sp-800-53/withdrawal_reason> ;

	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053StatementItem> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053StatementItem> ;
	linkml:pattern "^(([a-z]|[1-9][0-9]*)\\.|\\(([a-z]|[1-9][0-9]*)\\))$" ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/item_label"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/sp80053StatementItem__item_text> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	skos:prefLabel "item_text" ;
	linkml:description "The item's text, with the same placeholders for parameters as the statement's text." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053StatementItem> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053StatementItem> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/item_text"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/sp80053Statement__statement_text> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	skos:prefLabel "statement_text" ;
	linkml:description "The statement's own text, before any items. A placeholder of the form {{ insert: param, <identifier> }} marks where an organization-defined parameter is inserted." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Statement> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Statement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/statement_text"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/sp80053_control_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlIdentifier"^^xsd:anyURI ;
	linkml:description "A control's identifier: its family's letters, a hyphen and the control's number within the family, such as AC-2." ;
	linkml:pattern "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)-[1-9][0-9]*$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/sp80053_control_or_enhancement_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlOrEnhancementIdentifier"^^xsd:anyURI ;
	linkml:description "The identifier of a control or of a control enhancement, such as AC-2 or AC-2(1), where the publication cites either." ;
	linkml:pattern "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)-[1-9][0-9]*(\\([1-9][0-9]*\\))?$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/sp80053_enhancement_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/Sp80053EnhancementIdentifier"^^xsd:anyURI ;
	linkml:description "A control enhancement's identifier: its control's identifier and the enhancement's number in parentheses, such as AC-2(1)." ;
	linkml:pattern "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)-[1-9][0-9]*\\([1-9][0-9]*\\)$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/sp80053_family_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/Sp80053FamilyIdentifier"^^xsd:anyURI ;
	linkml:description "The two letters that name one of the twenty control families, such as AC for Access Control." ;
	linkml:pattern "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/sp80053_parameter_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/Sp80053ParameterIdentifier"^^xsd:anyURI ;
	linkml:description "The identifier NIST's catalog gives an organization-defined parameter, in lower case: the zero-padded control identifier, _odp and the parameter's number, such as ac-02_odp.01, or, for a parameter that aggregates several, the control identifier, _prm_ and a number, such as ac-1_prm_1." ;
	linkml:pattern "^[a-z]{2}-[0-9]{2}(\\.[0-9]{2})?_odp(\\.[0-9]{2})?$|^[a-z]{2}-[1-9][0-9]*(\\.[1-9][0-9]*)?_prm_[1-9][0-9]*$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/sp80053_withdrawal_target> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/Sp80053WithdrawalTarget"^^xsd:anyURI ;
	linkml:description "Where a withdrawn control or enhancement was incorporated, as the publication names it: a control or enhancement, such as AC-2 or AC-2(1), one item of a control's statement, such as AC-2k, or a whole family, such as SR." ;
	linkml:pattern "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)(-[1-9][0-9]*(\\([1-9][0-9]*\\))?([a-z](\\.[1-9][0-9]*)*|\\([a-z]\\)(\\([1-9][0-9]*\\))*)?)?$" ;
	linkml:typeof <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/sparqlpath> dcterms:conformsTo "https://www.w3.org/TR/sparql11-query/#propertypaths" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Sparqlpath"^^xsd:anyURI ;
	linkml:description "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/statement_items> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/statement_items"^^xsd:anyURI ;
	linkml:description "The lettered or numbered items of the statement, in order, each of which may hold items of its own." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Statement> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053StatementItem> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053StatementItem> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/Sp80053StatementItem> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/statement_items"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/statement_text> a linkml:SlotDefinition ;
	linkml:description "The statement's own text, before any items. A placeholder of the form {{ insert: param, <identifier> }} marks where an organization-defined parameter is inserted." .
<https://w3id.org/lmodel/nist-sp-800-53/string> a linkml:TypeDefinition ;
	skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
	skos:exactMatch "schema:Text"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/String"^^xsd:anyURI ;
	linkml:description "A character string" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/sub_objectives> a linkml:SlotDefinition ;
	linkml:description "The objectives grouped under this one, in order." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/Sp80053AssessmentObjective> .
<https://w3id.org/lmodel/nist-sp-800-53/time> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"." , "URI is dateTime because OWL reasoners do not work with straight date or time" ;
	skos:exactMatch "schema:Time"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
	linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/title> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/name"^^xsd:anyURI ;
	skos:note "It means what LOKF's title means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one title key." ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/title"^^xsd:anyURI ;
	linkml:description "The name SP 800-53 gives the family, control or control enhancement, or the title NIST's profile gives the baseline." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Baseline> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Family> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Baseline> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:slot_uri "http://schema.org/name"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/uri> dcterms:conformsTo "https://www.ietf.org/rfc/rfc3987.txt" ;
	a linkml:TypeDefinition ;
	skos:closeMatch "schema:URL"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node" ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/linkml/Uri"^^xsd:anyURI ;
	linkml:description "a complete URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/uriorcurie> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "URIorCURIE" ;
	linkml:definition_uri "https://w3id.org/linkml/Uriorcurie"^^xsd:anyURI ;
	linkml:description "a URI or a CURIE" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/withdrawal_reason> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/withdrawal_reason"^^xsd:anyURI ;
	linkml:description "For a withdrawn control or enhancement that the publication neither moved nor incorporated, what it says instead, such as that the enhancement is addressed through tailoring." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/withdrawal_reason"^^xsd:anyURI .

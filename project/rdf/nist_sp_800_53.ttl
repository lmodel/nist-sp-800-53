	linkml:uri "http://www.w3.org/ns/shex#iri"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/objective_label> a linkml:SlotDefinition ;
	linkml:description "The label SP 800-53A gives the objective, such as AC-02a.[01]." ;
	linkml:pattern "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)-[0-9]{2}(\\([0-9]{2}\\))?([a-z]\\.([0-9]{2})?)?(\\([a-z]\\)(\\([0-9]{2}\\))?)?(\\[[0-9]{2}\\])*$" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-53/objective_text> a linkml:SlotDefinition ;
	linkml:description "The determination statement, with the same placeholders for parameters as the control statement. A heading has none." .
<https://w3id.org/lmodel/nist-sp-800-53/parameter_guidelines> a linkml:SlotDefinition ;
	linkml:description "The guidelines that say what a value must settle, such as that the frequency of a review is defined." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/nist-sp-800-53/parameter_id> a linkml:SlotDefinition ;
	linkml:description "The parameter's identifier in NIST's catalog, such as ac-02_odp.01." ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/sp80053_parameter_identifier> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-53/parameter_label> a linkml:SlotDefinition ;
	linkml:description "For an assignment, what the organization defines, such as personnel or roles." .
<https://w3id.org/lmodel/nist-sp-800-53/reference_citation> a linkml:SlotDefinition ;
	linkml:description "The citation, as the catalog prints it." .
<https://w3id.org/lmodel/nist-sp-800-53/reference_label> a linkml:SlotDefinition ;
	linkml:description "The label the controls cite the publication by, such as SP 800-12." ;

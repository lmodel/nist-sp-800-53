	skos:broadMatch "oscal:Resource"^^xsd:anyURI ;
	skos:exactMatch "nist_sp_800_53:Reference"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/nist-sp-800-53/reference_citation> , <https://w3id.org/lmodel/nist-sp-800-53/reference_label> , <https://w3id.org/lmodel/nist-sp-800-53/reference_url> ;
	linkml:class_uri "https://w3id.org/lmodel/nist-sp-800-53/Reference"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/Sp80053Reference"^^xsd:anyURI ;
	linkml:description "A publication the catalog's references list, as they list it: its label, its citation and its address." ;
	linkml:slot_usage _:c14n0 ;
	linkml:slots <https://w3id.org/lmodel/nist-sp-800-53/sp80053Reference__reference_citation> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Reference__reference_label> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053Reference__reference_url> .
<https://w3id.org/lmodel/nist-sp-800-53/Sp80053SelectionCardinality> skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/Sp80053SelectionCardinality"^^xsd:anyURI ;
	linkml:description "How many of a selection's choices the organization picks." ;
	linkml:permissible_values <https://w3id.org/lmodel/nist-sp-800-53/ONE> , <https://w3id.org/lmodel/nist-sp-800-53/ONE_OR_MORE> .
<https://w3id.org/lmodel/nist-sp-800-53/Sp80053Statement> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://csrc.nist.gov/projects/risk-management/sp800-53-controls"^^xsd:anyURI ;
	skos:broadMatch "oscal:Part"^^xsd:anyURI ;
	skos:exactMatch "nist_sp_800_53:Statement"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/nist-sp-800-53/statement_text> ;
	linkml:class_uri "https://w3id.org/lmodel/nist-sp-800-53/Statement"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/Sp80053Statement"^^xsd:anyURI ;
	linkml:description "A control statement: the text of what a control or enhancement requires, and the items it is divided into." ;
	linkml:slot_usage _:c14n7 ;
	linkml:slots <https://w3id.org/lmodel/nist-sp-800-53/sp80053Statement__statement_text> , <https://w3id.org/lmodel/nist-sp-800-53/statement_items> .
<https://w3id.org/lmodel/nist-sp-800-53/Sp80053StatementItem> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://csrc.nist.gov/projects/risk-management/sp800-53-controls"^^xsd:anyURI ;
	skos:broadMatch "oscal:Part"^^xsd:anyURI ;
	skos:exactMatch "nist_sp_800_53:StatementItem"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/nist-sp-800-53/item_label> , <https://w3id.org/lmodel/nist-sp-800-53/item_text> ;
	linkml:class_uri "https://w3id.org/lmodel/nist-sp-800-53/StatementItem"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/Sp80053StatementItem"^^xsd:anyURI ;
	linkml:description "One lettered or numbered item of a control statement, which may hold items of its own." ;
	linkml:slot_usage _:c14n17 ;
	linkml:slots <https://w3id.org/lmodel/nist-sp-800-53/sp80053StatementItem__item_label> , <https://w3id.org/lmodel/nist-sp-800-53/sp80053StatementItem__item_text> , <https://w3id.org/lmodel/nist-sp-800-53/statement_items> .
<https://w3id.org/lmodel/nist-sp-800-53/TEST> linkml:description "Exercise mechanisms or activities under specified conditions." .
<https://w3id.org/lmodel/nist-sp-800-53/WITHDRAWN> linkml:description "Revision 5 withdrew the control or enhancement; incorporated_into, moved_to or withdrawal_reason says where it went." .
<https://w3id.org/lmodel/nist-sp-800-53/aggregated_parameters> a linkml:SlotDefinition ;
	linkml:description "For a parameter that stands for several, the parameters it aggregates, by identifier." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/sp80053_parameter_identifier> .
<https://w3id.org/lmodel/nist-sp-800-53/alternative_identifiers> a linkml:SlotDefinition ;
	linkml:description "The identifiers an earlier release of the catalog gave the parameter, such as ac-1_prm_2 for ac-01_odp.03." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/sp80053_parameter_identifier> .
<https://w3id.org/lmodel/nist-sp-800-53/alternative_label> a linkml:SlotDefinition ;
	linkml:description "The label SP 800-53 prints where it differs from the one SP 800-53A gives." .
<https://w3id.org/lmodel/nist-sp-800-53/assessment_label> a linkml:SlotDefinition ;
	linkml:description "The label SP 800-53A gives the parameter, such as AC-02_ODP[01]. A parameter that aggregates several has none." ;
	linkml:pattern "^(AC|AT|AU|CA|CM|CP|IA|IR|MA|MP|PE|PL|PM|PS|PT|RA|SA|SC|SI|SR)-[0-9]{2}(\\([0-9]{2}\\)|\\.[0-9]{2})?_ODP(\\[[0-9]{2}\\])?$" .
<https://w3id.org/lmodel/nist-sp-800-53/assessment_method> a linkml:SlotDefinition ;
	linkml:description "Which of the three methods this is." ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/Sp80053AssessmentMethodKind> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-53/assessment_methods> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/assessment_methods"^^xsd:anyURI ;
	linkml:description "The assessment methods SP 800-53A gives the control or enhancement, each with the objects it is applied to." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/Sp80053AssessmentMethod> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/assessment_methods"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/assessment_objective> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/assessment_objective"^^xsd:anyURI ;
	linkml:description "The assessment objective SP 800-53A gives the control or enhancement: the determination statements an assessor checks, nested as the statement's items are." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/Sp80053AssessmentObjective> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/assessment_objective"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/assessment_objects> a linkml:SlotDefinition ;
	linkml:description "The objects the method is applied to, in the order the publication lists them." ;
	linkml:multivalued true ;
	linkml:pattern "^\\s*\\S" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-53/baseline_controls> a linkml:SlotDefinition ;
	linkml:description "The controls and enhancements the baseline selects, by identifier, in the order the catalog gives them." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/sp80053_control_or_enhancement_identifier> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-53/baseline_level> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/baseline_level"^^xsd:anyURI ;
	linkml:description "Which of the four baselines this is." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Baseline> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Baseline> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/Sp80053BaselineLevel> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/baseline_level"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/boolean> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"." ;
	skos:exactMatch "schema:Boolean"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Bool" ;
	linkml:definition_uri "https://w3id.org/linkml/Boolean"^^xsd:anyURI ;
	linkml:description "A binary (true or false) value" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "bool" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/catalog_references> a linkml:SlotDefinition ;
	linkml:description "The publications the catalog's references list, most of which a control cites." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Reference> .
<https://w3id.org/lmodel/nist-sp-800-53/catalog_release> a linkml:SlotDefinition ;
	linkml:description "The release of Revision 5 the catalog carries, as NIST numbers it, such as 5.2.0." ;
	linkml:pattern "^[0-9]+\\.[0-9]+\\.[0-9]+$" ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-53/contributes_to_assurance> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/contributes_to_assurance"^^xsd:anyURI ;
	linkml:description "True where NIST's reference data marks the control or enhancement as one that contributes to assurance; absent otherwise." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/boolean> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/contributes_to_assurance"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/control_baselines> a linkml:SlotDefinition ;
	linkml:description "The control baselines of SP 800-53B that select from the catalog." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Baseline> .
<https://w3id.org/lmodel/nist-sp-800-53/control_discussion> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	skos:note "Where the catalog links a control or a statement item inside the text, a derivation keeps the link's text, which is the identifier as the publication prints it, and where it links a reference, the reference's label in brackets." ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/control_discussion"^^xsd:anyURI ;
	linkml:description "The discussion that follows the statement: context and guidance that help apply the control, which the publication does not require." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/control_discussion"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/control_enhancements> a linkml:SlotDefinition ;
	linkml:description "The control's enhancements. A knowledge bundle relates an enhancement to its control with isPartOf instead." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> .
<https://w3id.org/lmodel/nist-sp-800-53/control_families> a linkml:SlotDefinition ;
	linkml:description "The twenty control families, in the order SP 800-53 gives them." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Family> ;
	linkml:required true .
<https://w3id.org/lmodel/nist-sp-800-53/control_identifier> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/control_identifier"^^xsd:anyURI ;
	linkml:description "The control's identifier, such as AC-2." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/sp80053_control_identifier> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/control_identifier"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/control_parameters> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/control_parameters"^^xsd:anyURI ;
	linkml:description "The organization-defined parameters the statement leaves to the organization, in the order the catalog gives them." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Parameter> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/control_parameters"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/control_references> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/control_references"^^xsd:anyURI ;
	linkml:description "The publications the control or enhancement cites, by the labels the catalog's references carry, such as SP 800-12 or OMB A-130." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:pattern "^\\s*\\S" ;
	linkml:range <https://w3id.org/lmodel/nist-sp-800-53/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/nist-sp-800-53/control_references"^^xsd:anyURI .
<https://w3id.org/lmodel/nist-sp-800-53/control_statement> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/nist-sp-800-53"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/nist-sp-800-53/control_statement"^^xsd:anyURI ;
	linkml:description "The control statement: what the control or enhancement requires, as one text, a lettered or numbered list of items, or both." ;
	linkml:domain_of <https://w3id.org/lmodel/nist-sp-800-53/Sp80053Control> , <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/nist-sp-800-53/Sp80053ControlEnhancement> ;
